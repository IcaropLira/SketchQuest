+/** Acrescenta somente itens inéditos, preservando a ordem e os dados existentes. */
+export function aplicarExpansaoProfunda(themes: ThemeData[]): ThemeData[] {
+  for (const theme of themes) {
+    const extra = EXPANSAO_PROFUNDA[theme.id];
+    if (!extra) continue;
+    for (const key of ['subjects', 'adjectives', 'actions', 'settings', 'props', 'premade'] as const) {
+      const novos = extra[key];
+      if (!novos) continue;
+      const existentes = new Set(theme[key].map((item) => item.normalize('NFC').trim().toLocaleLowerCase('pt-BR')));
+      for (const item of novos) {
+        const normalizado = item.normalize('NFC').trim().toLocaleLowerCase('pt-BR');
+        if (normalizado && !existentes.has(normalizado)) {
+          theme[key].push(item);
+          existentes.add(normalizado);
+        }
+      }
+    }
+  }
+  return themes;
+}
