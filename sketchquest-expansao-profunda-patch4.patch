+      'num estúdio de televisão com portas para outras dimensões', 'num fliperama retrô escondido sob um shopping',
+      'numa loja de discos durante uma tempestade', 'numa praça coberta de cartazes de eventos fictícios'
+    ],
+    props: [
+      'com uma fita cassete que contém uma música inédita', 'com um pôster cheio de referências escondidas',
+      'com um ingresso para um evento que nunca aconteceu', 'com um walkman decorado com adesivos',
+      'com uma câmera instantânea que fotografa o futuro', 'com uma coleção de pins de universos imaginários'
+    ],
+    premade: [
+      'Crie um pôster de filme fictício que misture três gêneros completamente diferentes.',
+      'Desenhe uma convenção de cultura pop vista pelos olhos de alguém que caiu ali por engano.',
+      'Imagine uma locadora onde cada fita transporta quem assiste para um universo diferente.',
+      'Crie a capa de um álbum para uma banda formada por personagens de desenhos animados.',
+      'Desenhe uma vitrine cheia de objetos de franquias que não existem, mas parecem familiares.'
+    ]
+  }
+};
+
+function mergeUnique(target: string[], additions: string[]): void {
+  const seen = new Set(target.map((value) => value.normalize('NFC').trim().toLocaleLowerCase('pt-BR')));
+  for (const value of additions) {
+    const key = value.normalize('NFC').trim().toLocaleLowerCase('pt-BR');
+    if (key && !seen.has(key)) {
+      target.push(value);
+      seen.add(key);
+    }
+  }
+}
+
+export function aplicarPatch4(themes: ThemeData[]): ThemeData[] {
+  for (const theme of themes) {
+    const expansion = PATCH4[theme.id];
+    if (!expansion) continue;
+    for (const key of ['subjects', 'adjectives', 'actions', 'settings', 'props', 'premade'] as const) {
+      const additions = expansion[key];
+      if (additions?.length) mergeUnique(theme[key], additions);
+    }
+  }
+  return themes;
+}
